# =============================================================================
# VIHOLABS DELEGATE PORTAL — ENV CONTRACT
# =============================================================================
# Copia este archivo a .env (en el VPS) y rellena todos los valores.
# NUNCA commites el archivo .env con valores reales.
# Permisos en VPS: chmod 600 /var/www/portal/.env
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE — ambas formas necesarias (distintas rutas usan distintos nombres)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon_key>
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>
SUPABASE_DB_URL=postgresql://postgres.<ref>:<pass>@aws-1-eu-west-2.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# URLs DEL PORTAL — CRÍTICO: en VPS deben apuntar a portal.viholabs.com
# -----------------------------------------------------------------------------
APP_BASE_URL=https://portal.viholabs.com
NEXT_PUBLIC_SITE_URL=https://portal.viholabs.com

# -----------------------------------------------------------------------------
# HOLDED ERP
# -----------------------------------------------------------------------------
HOLDED_BASE_URL=https://api.holded.com
HOLDED_API_KEY=<holded_api_key>

# -----------------------------------------------------------------------------
# AUTH INTERNA — para /api/admin/* y crons del servidor
# Rotar antes de go-live si el valor estuvo en .env.local del entorno de dev
# -----------------------------------------------------------------------------
VIHOLABS_INTERNAL_BEARER=<random_seguro_minimo_32_chars>
PORTAL_BEARER_TOKEN=<mismo_valor_que_VIHOLABS_INTERNAL_BEARER>
PORTAL_BASE_URL=http://127.0.0.1:3000

# ID del actor MELQUISEDEC en la tabla actors
MELQUISEDEC_ACTOR_ID=d76c33b1-eaf2-47b3-b876-07d712d69c37

# -----------------------------------------------------------------------------
# SMTP — magic links y notificaciones de pedidos
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.ionos.es
SMTP_PORT=465
SMTP_USER=ruler@viholabs.com
SMTP_PASS=<smtp_password>
EMAIL_FROM=Viholabs <ruler@viholabs.com>

# -----------------------------------------------------------------------------
# DATOS LEGALES — PDFs de liquidación y mandatos SEPA
# -----------------------------------------------------------------------------
VIHOLABS_LEGAL_NAME=Viholabs Biotech S.L.
VIHOLABS_TAX_ID=B75950220
VIHOLABS_ADDRESS=Bac de Roda, 63. 08005 Barcelona.

# -----------------------------------------------------------------------------
# SHOPIFY
# -----------------------------------------------------------------------------
SHOPIFY_API_VERSION=2026-01
SHOPIFY_SHOP_DOMAIN=viholabs.myshopify.com
SHOPIFY_CLIENT_ID=<shopify_client_id>
SHOPIFY_CLIENT_SECRET=<shopify_client_secret>
SHOPIFY_ADMIN_ACCESS_TOKEN=<shopify_admin_access_token>

# -----------------------------------------------------------------------------
# OPENAI — Viholeta AI (embeddings). Dejar vacío = placeholder sin LLM
# -----------------------------------------------------------------------------
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
ENABLE_CRM_ACTIONS=false

# -----------------------------------------------------------------------------
# RUNTIME
# -----------------------------------------------------------------------------
NODE_ENV=production
