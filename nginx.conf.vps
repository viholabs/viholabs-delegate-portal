# Nginx configuration for Viholabs Delegate Portal
# Location: /etc/nginx/sites-available/portal.viholabs.com

limit_req_zone $binary_remote_addr zone=portal_general:10m rate=60r/m;
limit_req_zone $binary_remote_addr zone=portal_auth:10m rate=10r/m;

upstream nextjs_portal {
    server 127.0.0.1:3000;
    keepalive 64;
}

server {
    listen 80;
    server_name portal.viholabs.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name portal.viholabs.com;

    ssl_certificate     /etc/letsencrypt/live/portal.viholabs.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/portal.viholabs.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_stapling        on;
    ssl_stapling_verify on;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;

    # ============================================
    # BLOCK DEBUG ENDPOINTS
    # ============================================
    location = /api/debug/cookies    { return 404; }
    location = /api/security/rls-smoke { return 404; }

    # ============================================
    # WEBHOOK BIXGROW (NO RATE LIMIT)
    # ============================================
    location = /api/webhooks/bixgrow {
        proxy_pass http://nextjs_portal;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_pass_header Authorization;
    }

    # ============================================
    # HOLDED SYNC (LOCALHOST ONLY)
    # ============================================
    location = /api/holded/invoices/import-incremental {
        allow 127.0.0.1;
        deny all;
        proxy_pass http://nextjs_portal;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ============================================
    # LOGIN / AUTH (STRICT RATE LIMIT)
    # ============================================
    location ~ ^/(login|api/auth/) {
        limit_req zone=portal_auth burst=5 nodelay;
        proxy_pass http://nextjs_portal;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_pass_header Authorization;
        proxy_pass_header Cookie;
        proxy_pass_header Set-Cookie;
        proxy_cookie_flags ~ secure httponly samesite=lax;
    }

    # ============================================
    # MAIN APPLICATION
    # ============================================
    location / {
        limit_req zone=portal_general burst=20 nodelay;
        proxy_pass http://nextjs_portal;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_pass_header Authorization;
        proxy_pass_header Cookie;
        proxy_pass_header Set-Cookie;
        proxy_cookie_flags ~ secure httponly samesite=lax;
        proxy_connect_timeout 30s;
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;
        client_max_body_size  20M;
    }

    # ============================================
    # STATIC ASSETS (LONG CACHE)
    # ============================================
    location /_next/static/ {
        proxy_pass http://nextjs_portal;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # ============================================
    # LOGGING
    # ============================================
    access_log /var/log/nginx/portal.viholabs.com.access.log;
    error_log  /var/log/nginx/portal.viholabs.com.error.log warn;
}
