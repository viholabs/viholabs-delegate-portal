/* eslint-disable no-console */

import "dotenv/config";

import { createClient } from "@supabase/supabase-js";
import { holdedListContacts } from "../src/lib/holded/holdedClient";

const SUPABASE_URL = process.env.SUPABASE_URL!;
const SUPABASE_SERVICE_ROLE_KEY = process.env.SUPABASE_SERVICE_ROLE_KEY!;

if (!SUPABASE_URL || !SUPABASE_SERVICE_ROLE_KEY) {
  console.error("Missing SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY");
  process.exit(1);
}

const supabase = createClient(SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY);

type HoldedContact = {
  id?: string;
  _id?: string;
  name?: string | null;
  email?: string | null;
};

function extractHoldedId(c: HoldedContact): string | null {
  if (c.id && typeof c.id === "string") return c.id;
  if (c._id && typeof c._id === "string") return c._id;
  return null;
}

async function run() {
  console.log("Starting Holded contacts sync...");

  const contacts = await holdedListContacts<HoldedContact[]>();

  if (!Array.isArray(contacts)) {
    throw new Error("holdedListContacts returned non-array payload");
  }

  console.log("Contacts fetched from Holded:", contacts.length);

  let processed = 0;
  let skipped = 0;

  for (const c of contacts) {
    const holdedId = extractHoldedId(c);

    if (!holdedId) {
      skipped++;
      continue;
    }

    const row = {
      holded_contact_id: holdedId,
      name: c.name ?? null,
      email: c.email ?? null,
      updated_at: new Date().toISOString(),
    };

    const { error } = await supabase
      .from("holded_contacts")
      .upsert(row, {
        onConflict: "holded_contact_id",
      });

    if (error) {
      console.error("Upsert error:", error);
      throw error;
    }

    processed++;
  }

  console.log("Sync completed.");
  console.log("Processed:", processed);
  console.log("Skipped:", skipped);
}

run()
  .then(() => {
    console.log("Holded contacts sync finished OK");
    process.exit(0);
  })
  .catch((err) => {
    console.error("Holded contacts sync failed");
    console.error(err);
    process.exit(1);
  });